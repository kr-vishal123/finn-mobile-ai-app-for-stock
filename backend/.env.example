# ---- App ----
APP_ENV=dev
APP_NAME=FINN
# Comma-separated origins allowed to call the API (mobile web frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# ---- Database ----
# SQLite for local dev; swap for Postgres in prod, e.g.
# DATABASE_URL=postgresql+psycopg://finn:finn@localhost:5432/finn
DATABASE_URL=sqlite:///./data/finn.db

# ---- LLM routing ----
# Cheap/fast model: bulk work (announcement classification, one-line summaries, extraction).
# Strong model: reasoning (narrative vs numbers, bull/bear, network "why this person").
LLM_CHEAP_PROVIDER=anthropic
LLM_CHEAP_MODEL=claude-haiku-5-5
LLM_STRONG_PROVIDER=anthropic
LLM_STRONG_MODEL=claude-opus-5-5

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Cache LLM responses by prompt hash (saves cost on re-runs)
LLM_CACHE_ENABLED=true

# ---- Data sources ----
# NSE blocks default clients; send a browser-like UA
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SCREENER_BASE_URL=https://www.screener.in
NSE_BASE_URL=https://www.nseindia.com
# Where downloaded PDFs (annual reports, transcripts, filings) are cached
DOCS_CACHE_DIR=./data/docs

# ---- Push defaults (user can override per alert rule) ----
DEFAULT_DIGEST_WINDOW_HOURS=24
DEFAULT_VOLUME_SPIKE_MULTIPLE=2.0
DEFAULT_VOLUME_LOOKBACK_DAYS=20
DEFAULT_PRICE_MOVE_PCT=5.0
